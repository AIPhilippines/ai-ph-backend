# Supabase API Settings
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_KEY=your-supabase-anon-key

# Supabase PostgreSQL Connection Settings (for execute_sql migrations)
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-supabase-project-id
DB_PASSWORD=your-supabase-database-password

# Google Gemini API Settings
GOOGLE_API_KEY=your-google-gemini-api-key

# Microsoft SharePoint Credentials (optional fallback)
SHAREPOINT_CLIENT_ID=your-sharepoint-client-id
SHAREPOINT_CLIENT_SECRET=your-sharepoint-client-secret
SHAREPOINT_TENANT_ID=your-sharepoint-tenant-id
