## 3. Frontend Rich UI Integration Guide

To render flashcards and educational mini-games within the chat flow, the frontend parses the standard Markdown string for custom string tags.

### A. Flashcards Component Guide

#### Custom Tag Format:
`[FLASHCARDS:{"topic": "Supervised Learning", "cards": [{"front": "Q?", "back": "A!"}]}]`

#### CSS 3D Flipping Styles:
```css
/* Card Container */
.flashcard-wrapper {
  perspective: 1000px;
}
.flashcard-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  transform-style: preserve-3d;
}
/* Flip state class */
.flashcard-inner.flipped {
  transform: rotateY(180deg);
}
.flashcard-front, .flashcard-back {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 20px;
}
.flashcard-back {
  transform: rotateY(180deg);
}
```

#### React Component Implementation:
```tsx
interface Card {
  front: string;
  back: string;
}

export function FlashcardsWidget({ topic, cards }: { topic: string; cards: Card[] }) {
  const [currentIndex, setCurrentIndex] = useState(0);
  const [isFlipped, setIsFlipped] = useState(false);

  const currentCard = cards[currentIndex];

  return (
    <div className="flex flex-col items-center bg-slate-50 dark:bg-black/20 p-6 rounded-3xl border border-app-border">
      <h4 className="text-xs font-bold uppercase tracking-wider text-[var(--color-accent)] mb-4">🎴 Flashcard: {topic}</h4>
      
      {/* 3D Flipping Card Wrapper */}
      <div 
        onClick={() => setIsFlipped(!isFlipped)} 
        className="w-full max-w-sm h-48 cursor-pointer flashcard-wrapper select-none"
      >
        <div className={`flashcard-inner w-full h-full duration-500 ${isFlipped ? 'flipped' : ''}`}>
          {/* Front Side */}
          <div className="flashcard-front absolute inset-0 bg-white dark:bg-[#121212] border border-app-border p-6 flex flex-col justify-center items-center shadow-md">
            <span className="text-[10px] text-app-muted uppercase font-bold tracking-wider mb-2">Question / Concept</span>
            <p className="text-sm font-semibold text-app-text text-center">{currentCard.front}</p>
            <span className="text-[9px] text-[var(--color-accent)] font-medium mt-4">Click to flip 🔄</span>
          </div>

          {/* Back Side */}
          <div className="flashcard-back absolute inset-0 bg-[var(--color-accent)]/5 dark:bg-slate-900 border-2 border-[var(--color-accent)]/20 p-6 flex flex-col justify-center items-center shadow-md">
            <span className="text-[10px] text-[var(--color-accent)] uppercase font-bold tracking-wider mb-2">Answer / Definition</span>
            <p className="text-sm font-semibold text-app-text text-center">{currentCard.back}</p>
            <span className="text-[9px] text-app-muted font-medium mt-4">Click to see question 🔄</span>
          </div>
        </div>
      </div>

      {/* Pagination Controls */}
      <div className="flex items-center gap-4 mt-6">
        <button 
          disabled={currentIndex === 0} 
          onClick={() => { setIsFlipped(false); setCurrentIndex(p => p - 1); }}
          className="px-3 py-1.5 rounded-lg bg-app-bg border text-xs disabled:opacity-50"
        >
          Previous
        </button>
        <span className="text-xs text-app-muted font-mono">{currentIndex + 1} / {cards.length}</span>
        <button 
          disabled={currentIndex === cards.length - 1} 
          onClick={() => { setIsFlipped(false); setCurrentIndex(p => p + 1); }}
          className="px-3 py-1.5 rounded-lg bg-app-bg border text-xs disabled:opacity-50"
        >
          Next
        </button>
      </div>
    </div>
  );
}
```

