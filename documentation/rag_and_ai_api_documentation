### B. Stateful Educational Mini-Games Component Guide

#### Custom Tag Format:
`[MINIGAME:{"game_type": "guessing_game", "data": {"word": "OVERFITTING", "clue": "..."}}]`

#### React Stateful Component Implementation (3-Heart Guessing Game):
```tsx
interface GameData {
  word: string;
  clue: string;
}

export function GuessingGameWidget({ data }: { data: GameData }) {
  const targetWord = data.word.toUpperCase();
  const [guess, setGuess] = useState('');
  const [tries, setTries] = useState(3);
  const [revealedLetters, setRevealedLetters] = useState<string[]>([]);
  const [gameState, setGameState] = useState<'playing' | 'won' | 'lost'>('playing');

  // Submit letter or full word guess
  const handleGuessSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (!guess || gameState !== 'playing') return;

    const gClean = guess.toUpperCase().trim();
    setGuess('');

    // Full word guess
    if (gClean === targetWord) {
      setRevealedLetters(targetWord.split(''));
      setGameState('won');
      return;
    }

    // Single letter guess
    if (gClean.length === 1) {
      if (targetWord.includes(gClean)) {
        const nextLetters = [...revealedLetters, gClean];
        setRevealedLetters(nextLetters);
        
        // Check if all distinct letters guessed
        const allGuessed = targetWord.split('').every(char => char === ' ' || nextLetters.includes(char));
        if (allGuessed) {
          setGameState('won');
        }
      } else {
        const nextTries = tries - 1;
        setTries(nextTries);
        if (nextTries <= 0) setGameState('lost');
      }
    } else {
      // Wrong full word guess
      const nextTries = tries - 1;
      setTries(nextTries);
      if (nextTries <= 0) setGameState('lost');
    }
  };

  return (
    <div className="flex flex-col items-center bg-slate-50 dark:bg-black/20 p-6 rounded-3xl border border-app-border w-full max-w-md">
      
      {/* Game Header with Heart Lives indicator */}
      <div className="w-full flex justify-between items-center mb-4">
        <h4 className="text-xs font-bold uppercase tracking-wider text-[var(--color-accent)]">🎮 Guess the AI Term</h4>
        <div className="flex gap-1">
          {[1, 2, 3].map((heartIdx) => (
            <span key={heartIdx} className="text-base transition-all duration-300">
              {heartIdx <= tries ? '❤️' : '💔'}
            </span>
          ))}
        </div>
      </div>

      <div className="bg-white dark:bg-[#121212] border border-app-border rounded-2xl p-5 w-full text-center shadow-sm">
        <p className="text-xs text-app-muted uppercase font-bold tracking-wider mb-2">Clue / Kahulugan</p>
        <p className="text-sm font-medium text-app-text leading-relaxed mb-6">"{data.clue}"</p>

        {/* Word Placeholders */}
        <div className="flex justify-center gap-1.5 mb-6 overflow-x-auto py-1">
          {targetWord.split('').map((char, index) => {
            if (char === ' ') return <span key={index} className="w-4" />;
            const isRevealed = revealedLetters.includes(char) || gameState === 'lost';
            return (
              <span 
                key={index} 
                className={`w-8 h-9 border-b-2 flex items-center justify-center font-bold text-base transition-colors ${
                  isRevealed 
                    ? 'border-[var(--color-accent)] text-app-text' 
                    : 'border-neutral-300 dark:border-neutral-700 text-transparent'
                }`}
              >
                {char}
              </span>
            );
          })}
        </div>

        {/* Interaction Panel */}
        {gameState === 'playing' && (
          <form onSubmit={handleGuessSubmit} className="flex gap-2">
            <input
              type="text"
              maxLength={targetWord.length}
              value={guess}
              onChange={e => setGuess(e.target.value)}
              placeholder="Sulat ng letra o buong salita..."
              className="flex-1 bg-app-bg-soft border border-app-border rounded-xl py-2 px-3 text-xs sm:text-sm text-app-text focus:border-[var(--color-accent)]/80 outline-none"
            />
            <button 
              type="submit" 
              className="bg-[var(--color-accent)] text-white font-bold text-xs uppercase px-4 py-2 rounded-xl"
            >
              Guess
            </button>
          </form>
        )}

        {/* Game End States with celebration styling */}
        {gameState === 'won' && (
          <div className="p-3 bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 rounded-xl text-xs font-bold animate-bounce mt-2 select-none">
            🎉 Mahusay! You guessed the correct term: <strong>{targetWord}</strong>!
          </div>
        )}
        {gameState === 'lost' && (
          <div className="p-3 bg-red-500/10 border border-red-500/20 text-red-500 rounded-xl text-xs font-bold mt-2 select-none">
            😢 Sayang, subukan uli! The correct term was: <strong>{targetWord}</strong>.
          </div>
        )}
      </div>
    </div>
  );
}
```
